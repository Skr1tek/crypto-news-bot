[Unit]
Description=Public Telegram channel monitor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=newsbot
Group=newsbot
WorkingDirectory=/opt/newsbot
EnvironmentFile=/etc/newsbot.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/newsbot/.venv/bin/python /opt/newsbot/tgmonitor.py
Restart=on-failure
RestartSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/newsbot

[Install]
WantedBy=multi-user.target
